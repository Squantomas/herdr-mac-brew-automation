<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.tom.claude-restart</string>
  <key>ProgramArguments</key>
  <array><string>__HOME__/bin/claude-restart-idle.sh</string></array>
  <key>WatchPaths</key>
  <array><string>/opt/homebrew/Caskroom/claude-code</string></array>
  <key>ThrottleInterval</key><integer>30</integer>
  <key>StandardOutPath</key><string>__HOME__/brew-reports/claude-restart.out</string>
  <key>StandardErrorPath</key><string>__HOME__/brew-reports/claude-restart.err</string>
</dict>
</plist>
